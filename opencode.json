{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "inferhub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "hub",
      "options": {
        "baseURL": "https://api.inferhub.dev/v1",
        "apiKey": "sk-airo-mM2tVrDyPYB5uBhQzF0P5RWj"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "gpt-5.6 luna",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "cx/gpt-5.6-luna": {
          "name": "cx/gpt-5.6 luna",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "alicn/deepseek-v4.1-flash": {
          "name": "cn/deepseek-v4.1-flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek v4.1 flash",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "typst": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "--rm",
          "-i",
          "ghcr.io/johannesbrandenburger/typst-mcp:latest"
        ]
      },
      "kettle": {
        "type": "local",
        "command": [
          "node",
          "/home/ell/kettle-mcp/dist/index.js"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 60000
        }
      },
      "excel": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "@negokaz/excel-mcp-server"
        ],
        "environment": {
          "EXCEL_MCP_PAGING_CELLS_LIMIT": "4000"
        },
        "timeout": {
          "startup": 120000,
          "catalog": 60000,
          "execution": 60000
        }
      },
      "presenton": {
        "type": "local",
        "command": [
          "node",
          "/home/ell/presenton/mcp-proxy/index.mjs"
        ],
        "environment": {
          "PRESENTON_URL": "http://127.0.0.1:5001",
          "PRESENTON_KEY": "sk-presenton-f513bc94dfdc519f.LLmLzTHJAxJIHcUZ5GsJ3j9-l8SL3nDR8TFuWXlTFgfyRQRBMQfugQ"
        },
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      }
    }
  }
}
